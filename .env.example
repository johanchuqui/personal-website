# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real secrets.
# Variables starting with NEXT_PUBLIC_ are sent to the browser, so only put
# public values in them. Everything else stays on the server.

# Base URL of the site (http://localhost:3000 locally, https://yourdomain.com in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (added in M2) — Project Settings → API Keys ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET: bypasses row-level security. Server only.
SUPABASE_SECRET_KEY=

# --- Cloudflare Turnstile spam protection (added in M8) ---
# Test keys that always pass: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Resend email (added in M8) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=johanchuqui05@gmail.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Random string used to hash visitor IPs for rate limiting (openssl rand -hex 32)
IP_HASH_SALT=
